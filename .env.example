# 使い方: このファイルを .env にコピーして値を入れる（.env は .gitignore 済み）
#   cp .env.example .env

# 要約・まとめ用（フェーズ4・5で使用）
ANTHROPIC_API_KEY=

# 経済指標の発表予定日（フェーズ3で使用）https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 任意: Notion への書き出し先の親ページID（run --publish / publish コマンドで使用）
NOTION_PAGE_ID=

# 任意: Discord 通知用の Webhook URL（フェーズ5で実装予定）
DISCORD_WEBHOOK_URL=

# bitbank-lab-mcp は公開データだけを使うため、API キーは不要
